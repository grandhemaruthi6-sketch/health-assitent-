# ==============================================================================
# HealthCopilot AI — Backend & OCR Configuration (.env)
# ==============================================================================

# Frontend API base URL (include /api; production should use your deployed backend URL)
VITE_API_BASE_URL=http://localhost:5001/api

# Server Port
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# OCR Provider Configuration
# Supported options:
#   - 'google-cloud-documentai' (Production Document AI)
#   - 'test-synthetic' (Local testing mode without cloud credentials)
# ------------------------------------------------------------------------------
OCR_PROVIDER=google-cloud-documentai

# ------------------------------------------------------------------------------
# Google Cloud Document AI Credentials
# Instructions:
# 1. Enable Document AI API: `gcloud services enable documentai.googleapis.com`
# 2. Create an OCR or Form Parser processor in the Google Cloud Console:
#    Navigation: Document AI > Processors > Create Processor > "Document OCR" or "Form Parser"
# 3. Fill in your Project ID, Location ('us' or 'eu'), and Processor ID below.
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
GCP_PROCESSOR_ID=your-16-digit-processor-id

# Service Account Key File (Option A - File Path)
# Ensure the service account has the role 'roles/documentai.apiUser'
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Service Account Key JSON (Option B - Inline string for container/cloud deployment)
# GCP_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# OCR Processing Timeout in Milliseconds (Default: 45000 = 45s)
OCR_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Firebase Web App Configuration (Frontend Vite Client)
# Obtain these from Firebase Console > Project Settings > General > Your Apps > Web App
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
